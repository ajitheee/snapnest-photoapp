generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  passwordHash      String?
  name              String
  isAdmin           Boolean         @default(false)
  storageLimitBytes BigInt?
  storageUsedBytes  BigInt          @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  assets            Asset[]
  albums            Album[]
  shareLinks        ShareLink[]
  people            Person[]
  smartAlbums       SmartAlbum[]
  deviceTokens      DeviceToken[]
  uploadSessions    UploadSession[]
  oauthIdentities   OauthIdentity[]

  @@map("users")
}

model OauthIdentity {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@map("oauth_identities")
}

model Asset {
  id                 String                      @id @default(uuid())
  ownerId            String
  owner              User                        @relation(fields: [ownerId], references: [id])
  // Mobile: client-side identifier so device can track sync state without a server round-trip
  deviceAssetId      String?
  originalPath       String
  thumbnailSmallPath String?
  thumbnailLargePath String?
  fileName           String
  fileSizeBytes      BigInt
  mimeType           String
  checksum           String                      @unique
  type               AssetType
  fileCreatedAt      DateTime
  width              Int?
  height             Int?
  duration           Int?
  exifData           Json?
  locationLat        Float?
  locationLng        Float?
  locationCity       String?
  locationState      String?
  locationCountry    String?
  isFavorite         Boolean                     @default(false)
  isArchived         Boolean                     @default(false)
  isDeleted          Boolean                     @default(false)
  deletedAt          DateTime?
  // Live Photo / Motion Photo (iOS Live Photo or Google Motion Photo)
  isLivePhoto        Boolean                     @default(false)
  livePhotoVideoPath String?
  clipEmbedding      Unsupported("vector(512)")?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  tags               AssetTag[]
  jobStatus          AssetJobStatus?
  albums             AlbumAsset[]
  albumCovers        Album[]                     @relation("AlbumCover")
  shareLinks         ShareLink[]
  faces              Face[]

  @@map("assets")
}

model AssetTag {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag        String
  confidence Float
  createdAt  DateTime @default(now())

  @@unique([assetId, tag])
  @@map("asset_tags")
}

model AssetJobStatus {
  assetId         String    @id
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  thumbnailDoneAt DateTime?
  metadataDoneAt  DateTime?
  geocodeDoneAt   DateTime?
  transcodeDoneAt DateTime?
  clipEmbeddedAt  DateTime?
  faceDetectedAt  DateTime?
  sceneTaggedAt   DateTime?
  faceData        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("asset_job_status")
}

model Album {
  id           String       @id @default(uuid())
  ownerId      String
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  coverAssetId String?
  coverAsset   Asset?       @relation("AlbumCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assets       AlbumAsset[]
  shareLinks   ShareLink[]

  @@map("albums")
}

model AlbumAsset {
  albumId String
  assetId String
  album   Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  asset   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@id([albumId, assetId])
  @@map("album_assets")
}

model ShareLink {
  id           String    @id @default(uuid())
  token        String    @unique
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  albumId      String?
  album        Album?    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  assetId      String?
  asset        Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  passwordHash String?
  expiresAt    DateTime?
  viewCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("share_links")
}

model Face {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ownerId    String
  faceIndex  Int
  bbox       Json
  embedding  Json
  confidence Float
  personId   String?
  person     Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([assetId, faceIndex])
  @@map("faces")
}

model Person {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  coverFaceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  faces       Face[]

  @@map("people")
}

model SmartAlbum {
  id           String         @id @default(uuid())
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  type         SmartAlbumType
  criteria     Json
  coverAssetId String?
  assetCount   Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("smart_albums")
}

// ─── Phase 5: Mobile & Sync ───────────────────────────────────────────────────

/// FCM / APNs push tokens. One user → many devices.
/// Re-registering an existing token is a no-op (upsert by token).
model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         @unique
  platform   DevicePlatform
  appVersion String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("device_tokens")
}

/// Resumable chunked upload session. Mobile clients create a session, stream
/// chunks (each PUT includes the byte offset), then call /complete to assemble
/// the file and hand it off to the normal upload pipeline.
model UploadSession {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checksum      String    // SHA-256 of the complete file (client-supplied)
  fileName      String
  fileSize      BigInt
  mimeType      String
  bytesReceived BigInt    @default(0)
  chunkDir      String    // Absolute path holding in-flight chunk files
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@map("upload_sessions")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AssetType {
  IMAGE
  VIDEO
  OTHER
}

enum SmartAlbumType {
  PERSON
  LOCATION
  DATE_RANGE
  TAG
}

enum DevicePlatform {
  IOS
  ANDROID
}
