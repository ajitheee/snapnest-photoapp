generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  passwordHash      String?
  name              String
  isAdmin           Boolean         @default(false)
  storageLimitBytes BigInt?
  storageUsedBytes  BigInt          @default(0)
  preferences       Json?
  hiddenPin         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  assets            Asset[]
  albums            Album[]
  albumFolders      AlbumFolder[]
  albumShares       AlbumShare[] @relation("AlbumShareOwner")
  sharedAlbums      AlbumShare[] @relation("AlbumShareReceiver")
  shareLinks        ShareLink[]
  people            Person[]
  smartAlbums       SmartAlbum[]
  deviceTokens      DeviceToken[]
  uploadSessions    UploadSession[]
  oauthIdentities   OauthIdentity[]
  recaps            Recap[]

  @@map("users")
}

model OauthIdentity {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@map("oauth_identities")
}

model Asset {
  id                 String                      @id @default(uuid())
  ownerId            String
  owner              User                        @relation(fields: [ownerId], references: [id])
  // Mobile: client-side identifier so device can track sync state without a server round-trip
  deviceAssetId      String?
  originalPath       String
  thumbnailSmallPath String?
  thumbnailLargePath String?
  fileName           String
  fileSizeBytes      BigInt
  mimeType           String
  checksum           String
  type               AssetType
  fileCreatedAt      DateTime
  width              Int?
  height             Int?
  duration           Int?
  exifData           Json?
  locationLat        Float?
  locationLng        Float?
  locationCity       String?
  locationState      String?
  locationCountry    String?
  isFavorite         Boolean                     @default(false)
  isArchived         Boolean                     @default(false)
  isDeleted          Boolean                     @default(false)
  deletedAt          DateTime?
  // Live Photo / Motion Photo (iOS Live Photo or Google Motion Photo)
  isLivePhoto        Boolean                     @default(false)
  livePhotoVideoPath String?
  appleContentId     String?   // Apple Live Photo Content Identifier (pairs HEIC + MOV automatically)
  // Phase 8: Intelligence Foundation
  caption            String?
  ocrText            String?
  perceptualHash     String?
  // Live Photo effects
  liveEffect           String?
  liveEffectPath       String?
  keyPhotoTimestampMs  Int?
  // Photo / Video editing
  editedPath         String?
  editParams         Json?
  clipEmbedding      Unsupported("vector(512)")?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  tags               AssetTag[]
  jobStatus          AssetJobStatus?
  albums             AlbumAsset[]
  albumCovers        Album[]                     @relation("AlbumCover")
  shareLinks         ShareLink[]
  faces              Face[]

  @@unique([ownerId, checksum])
  @@map("assets")
}

model AssetTag {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag        String
  confidence Float
  createdAt  DateTime @default(now())

  @@unique([assetId, tag])
  @@map("asset_tags")
}

model AssetJobStatus {
  assetId         String    @id
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  thumbnailDoneAt DateTime?
  metadataDoneAt  DateTime?
  geocodeDoneAt   DateTime?
  transcodeDoneAt DateTime?
  clipEmbeddedAt  DateTime?
  faceDetectedAt  DateTime?
  sceneTaggedAt   DateTime?
  ocrDoneAt       DateTime?
  pHashDoneAt     DateTime?
  faceData        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("asset_job_status")
}

model Album {
  id           String       @id @default(uuid())
  ownerId      String
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  coverAssetId String?
  coverAsset   Asset?       @relation("AlbumCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  folderId     String?
  folder       AlbumFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  allowContributions Boolean @default(false)
  assets       AlbumAsset[]
  shareLinks   ShareLink[]
  sharedWith   AlbumShare[]
  comments     AlbumComment[]
  likes        AlbumLike[]
  activity     AlbumActivity[]

  @@map("albums")
}

model AlbumFolder {
  id        String        @id @default(uuid())
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    AlbumFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  AlbumFolder[] @relation("FolderHierarchy")
  sortOrder Int           @default(0)
  albums    Album[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("album_folders")
}

model AlbumAsset {
  albumId String
  assetId String
  album   Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  asset   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@id([albumId, assetId])
  @@map("album_assets")
}

model AlbumShare {
  id                String    @id @default(uuid())
  albumId           String
  album             Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User      @relation("AlbumShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWithEmail   String
  sharedWithId      String?
  sharedWith        User?     @relation("AlbumShareReceiver", fields: [sharedWithId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())

  @@unique([albumId, sharedWithEmail])
  @@map("album_shares")
}

model ShareLink {
  id           String    @id @default(uuid())
  token        String    @unique
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  albumId      String?
  album        Album?    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  assetId      String?
  asset        Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  passwordHash String?
  expiresAt    DateTime?
  viewCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("share_links")
}

model Face {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ownerId    String
  faceIndex  Int
  bbox       Json
  embedding  Json
  confidence Float
  personId   String?
  person     Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([assetId, faceIndex])
  @@map("faces")
}

model Person {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  coverFaceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  faces       Face[]

  @@map("people")
}

model SmartAlbum {
  id           String         @id @default(uuid())
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  type         SmartAlbumType
  criteria     Json
  coverAssetId String?
  assetCount   Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("smart_albums")
}

// ─── Phase 8: Intelligence Foundation ─────────────────────────────────────────

model DuplicateGroup {
  id        String   @id @default(uuid())
  ownerId   String
  assetIds  Json
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@map("duplicate_groups")
}

// ─── Phase 5: Mobile & Sync ───────────────────────────────────────────────────

/// FCM / APNs push tokens. One user → many devices.
/// Re-registering an existing token is a no-op (upsert by token).
model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         @unique
  platform   DevicePlatform
  appVersion String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("device_tokens")
}

/// Resumable chunked upload session. Mobile clients create a session, stream
/// chunks (each PUT includes the byte offset), then call /complete to assemble
/// the file and hand it off to the normal upload pipeline.
model UploadSession {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checksum      String    // SHA-256 of the complete file (client-supplied)
  fileName      String
  fileSize      BigInt
  mimeType      String
  bytesReceived BigInt    @default(0)
  chunkDir      String    // Absolute path holding in-flight chunk files
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@map("upload_sessions")
}

// ─── Phase 7: Weekly Recaps ───────────────────────────────────────────────────

model Recap {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  weekEnd     DateTime
  videoPath   String?
  coverPath   String?
  assetIds    Json
  photoCount  Int
  locationSummary String?
  peopleSummary   String?
  status      RecapStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, weekStart])
  @@map("recaps")
}

// ─── Phase 9: Family & Collaboration ─────────────────────────────────────────

model AlbumComment {
  id        String   @id @default(uuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  assetId   String?
  userId    String
  userName  String
  text      String
  createdAt DateTime @default(now())

  @@map("album_comments")
}

model AlbumLike {
  id        String   @id @default(uuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  assetId   String
  userId    String
  userName  String
  createdAt DateTime @default(now())

  @@unique([albumId, assetId, userId])
  @@map("album_likes")
}

model AlbumActivity {
  id        String   @id @default(uuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  action    String
  assetId   String?
  text      String?
  createdAt DateTime @default(now())

  @@map("album_activity")
}

model SharedLibrary {
  id        String              @id @default(uuid())
  name      String
  ownerId   String
  rules     Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  members   SharedLibraryMember[]

  @@map("shared_libraries")
}

model SharedLibraryMember {
  id              String        @id @default(uuid())
  sharedLibraryId String
  sharedLibrary   SharedLibrary @relation(fields: [sharedLibraryId], references: [id], onDelete: Cascade)
  userId          String
  role            String        @default("member")
  joinedAt        DateTime      @default(now())

  @@unique([sharedLibraryId, userId])
  @@map("shared_library_members")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AssetType {
  IMAGE
  VIDEO
  OTHER
}

enum SmartAlbumType {
  PERSON
  LOCATION
  DATE_RANGE
  TAG
}

enum DevicePlatform {
  IOS
  ANDROID
}

enum RecapStatus {
  PENDING
  GENERATING
  READY
  FAILED
}
